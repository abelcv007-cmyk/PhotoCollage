<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de la celda: con borde grueso violeta cuando la foto está seleccionada. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cell_selected" />
            <corners android:radius="10dp" />
            <stroke
                android:width="4dp"
                android:color="@color/brand_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cell_placeholder" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="@color/outline_variant" />
        </shape>
    </item>
</selector>
